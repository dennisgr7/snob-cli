---
import Cursor from '@/components/Cursor.astro';
import HeroVideo from '@/components/HeroVideo.astro';
import InstallHero from '@/components/InstallHero.astro';
import { HERO } from '@/lib/content';

/**
 * The wink: the question everybody asks, the answer in one sentence, the
 * install, and the tool beside it, recorded.
 */
---

<section aria-labelledby="hero-title" class="mx-auto max-w-page px-4 pt-10 pb-16 sm:px-6 md:pt-20 md:pb-28">
  <div class="grid items-center gap-12 lg:grid-cols-[1.1fr_1fr]">
    <div>
      <h1 id="hero-title" class="font-mono text-hero font-bold">
        {HERO.title} <span class="whitespace-nowrap"><span class="text-accent">{HERO.accent}</span><Cursor /></span>
      </h1>
      <p class="mt-6 max-w-[52ch] text-lg text-muted">{HERO.lead}</p>
      <InstallHero />
    </div>
    <HeroVideo />
  </div>
</section>
