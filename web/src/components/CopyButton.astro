---
/**
 * Copies a command. It is `hidden` in the HTML and the page script shows it,
 * because without JavaScript it could not copy anything (DESIGN.md).
 */
interface Props {
  /** The commands, one per line on the clipboard. */
  commands: readonly string[];
  /** What is being copied, for a screen reader: "Copy the macOS install". */
  label: string;
}

const { commands, label } = Astro.props;
---

<button
  type="button"
  hidden
  data-copy={JSON.stringify(commands)}
  aria-label={label}
  title="Copy"
  class="rounded-control border border-term-line bg-term-bg p-1.5 text-term-dim hover:text-term-text"
>
  {/* The spans are what the script hides and shows; an SVG has no `hidden`. */}
  <span data-copy-idle>
    <svg
      aria-hidden="true"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="block size-4"
    >
      <rect width="14" height="14" x="8" y="8" rx="2"></rect>
      <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
    </svg>
  </span><span data-copy-done hidden>
    <svg
      aria-hidden="true"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="block size-4"
    >
      <path d="M20 6 9 17l-5-5"></path>
    </svg>
  </span>
</button>

<script>
  import { announce } from '@/scripts/announce';

  // Only where the clipboard can be written: elsewhere the buttons stay hidden.
  if (navigator.clipboard?.writeText) {
    for (const button of document.querySelectorAll<HTMLButtonElement>('button[data-copy]')) {
      const idle = button.querySelector<HTMLElement>('[data-copy-idle]');
      const done = button.querySelector<HTMLElement>('[data-copy-done]');
      let reset: number | undefined;
      button.hidden = false;
      button.addEventListener('click', async () => {
        try {
          // JSON in the attribute: the HTML compressor would bend a raw newline.
          const commands: string[] = JSON.parse(button.dataset.copy ?? '[]');
          await navigator.clipboard.writeText(commands.join('\n'));
        } catch {
          announce('Could not copy. Select the command instead.');
          return;
        }
        if (idle && done) {
          idle.hidden = true;
          done.hidden = false;
          window.clearTimeout(reset);
          reset = window.setTimeout(() => {
            idle.hidden = false;
            done.hidden = true;
          }, 2000);
        }
        announce('Copied');
      });
    }
  }
</script>
